# Copy to .env.local and edit as needed. Git-ignored.

# Backend the Vite dev-server proxy forwards /api and /openapi.json to.
# Only used in `npm run dev`. Leave blank to accept the default
# (http://127.0.0.1:8000).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Backend URL baked into the production build. When empty, the bundle
# uses path-relative URLs (works when the GUI is served on the same
# origin as the backend, or behind a proxy that rewrites /api).
# Set to a full URL (https://api.example.com) when the GUI is hosted
# on a different origin than the backend.
VITE_API_BASE_URL=
