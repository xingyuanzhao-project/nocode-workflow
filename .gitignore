# Exclusion principle:
# Production exclusion (what Render/Docker should not see) is handled by .dockerignore.
# .gitignore is only for things that must never enter the git repo at all:
# secrets, generated bytecode, and large run artifacts that would bloat history.
#
# Runtime directories (server/codebooks/, server/workflows/, server/data/) are
# intentionally NOT gitignored — agents and git can see them. .dockerignore
# keeps them out of the production image.
# When adding files to gitignore, must un ignore them in .cursorignore

references/

# Secrets
.env
hftoken.md

# Python environments
.venv/
__pycache__/
*.pyc

# Flow run artefacts
results_custom/
processing.log

# Run artefacts — kept out of git to prevent repo bloat (80+ dirs, large files)
server/runs/

# Astro build output
docs/node_modules/
docs/dist/
docs/.astro/

# Large data files (over GitHub 100 MB limit)
data/ncsl_bills.jsonl
server/data/*.jsonl
